<Project>

  <!--
    Repository layout:
      FunQuery.csproj          core language + in-memory interpreter
      src/                     adapters (for example the ASP.NET Core host adapter)
      hosts/                   runnable sample hosts
      tests/                   test projects (in-memory only, no database required)

    The root project globs **/*.cs, so every directory that belongs to another
    project must be excluded. Otherwise those sources would be compiled into
    FunQuery itself.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;src/**;hosts/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Lexer and a few other pieces are internal; let the test project see them. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'FunQuery'">
    <InternalsVisibleTo Include="FunQuery.Tests" />
  </ItemGroup>

  <!-- The HTTP adapter's error helpers are internal; its test project verifies them directly. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'FunQuery.AspNetCore'">
    <InternalsVisibleTo Include="FunQuery.AspNetCore.Tests" />
  </ItemGroup>

</Project>
