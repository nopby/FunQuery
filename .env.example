# Copy this file to .env (ignored by git) or export the value in your shell.
# The connection string is used by the PostgreSQL host and live tests.
#
# Bash/zsh:    set -a; source .env; set +a
# PowerShell:  $env:FUNQUERY_POSTGRES = 'Host=127.0.0.1;Port=5433;Username=postgres;Password=postgres;Database=postgres'
FUNQUERY_POSTGRES="Host=127.0.0.1;Port=5433;Username=postgres;Password=postgres;Database=postgres"
